{
  // Used only when ASPNETCORE_ENVIRONMENT is "Development" (dotnet run). It overrides appsettings.json.
  // Secrets (the admin login, the token key, the API key) are not here: they come from the .env file.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
