{
  // How much the server writes to its log. "Information" shows each request and each database command.
  // "Microsoft.AspNetCore" is set to "Warning" so the framework's own messages stay quiet.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // The host names the server answers to. "*" means any.
  "AllowedHosts": "*",

  // The database: a SQLite file, created and updated by itself at startup. The path is relative to where the API runs
  // (in Docker it is /app/data, which is the server-data volume).
  "ConnectionStrings": {
    "Default": "Data Source=data/ticketing.db"
  },

  // The login token (JWT).
  //   Issuer, Audience   names written into the token and checked when it comes back.
  //   ExpiryMinutes      how long a login lasts.
  //   Key                the secret that signs the token, at least 32 characters. It is NOT in this file on purpose: it comes
  //                      from the .env file (Jwt__Key), and the server refuses to start without it.
  "Jwt": {
    "Issuer": "TicketingAI",
    "Audience": "TicketingAI.Client",
    "ExpiryMinutes": 60
  },

  // The admin login. It is not a row in the database. There is no value here on purpose: Admin__Username and
  // Admin__Password come from the .env file, and the server refuses to start without them.

  // Which web addresses may call the API from a browser (CORS), separated by commas, for example
  // "https://ticketingai.example.com". Needed only when the client is hosted on another address, such as Vercel.
  // Empty means CORS is off, which is right when the page and the API share an address (the Vite dev server, nginx in Docker).
  // Environment variable: Cors__AllowedOrigins
  "Cors": {
    "AllowedOrigins": ""
  },

  // The key for an external chat API (Gemini, Cloudflare Workers AI, ...), used when the chat provider is "api".
  // Leave it empty here and put it in the .env file as ChatApi__ApiKey, so the key never ends up in git.
  //
  // Everything else about the AI assistant that is not secret is NOT in this file: where Ollama runs, the chat provider,
  // the chat API address, the models, the prompt and how the knowledge is searched are settings in the database. An admin
  // changes them on the Settings page (AI assistant tab), and they apply to the next message with no restart.
  "ChatApi": {
    "ApiKey": ""
  }
}
