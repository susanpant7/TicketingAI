# Copy this file to .env and set the values. .env is NOT committed (it is in .gitignore).
# One file for both ways of running the app: Docker Compose passes it to the server container, and `dotnet run`
# reads it at startup (Development only). The names are the .NET configuration names: a double underscore is a colon,
# so Admin__Password is the setting Admin:Password.

# The admin login (not a row in the database).
Admin__Username=admin
Admin__Password=change-me

# Signs the login token. At least 32 characters. Generate one with: openssl rand -base64 48
Jwt__Key=change-me-to-a-long-random-secret-of-at-least-32-characters

# The key of each online AI service you use, for the chat model and for the embedding model. Each key has its own variable: the
# Settings page saves only the NAME of the variable (for example GROQ_API_KEY), never the key. A name must end in API_KEY. Leave a key
# empty when you do not use that service. Ollama needs no key.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_API_KEY=
OPENAI_API_KEY=

# The key of the first version, used when a model has no key name. Not needed once each model has its own key name.
ChatApi__ApiKey=

# Optional: the starting values of the AI settings for a NEW database (and what "Restore defaults" restores). They
# are normally set on the Settings page instead, so most people leave these out.
# AiDefaults__EmbeddingBaseUrl=http://localhost:11434
# AiDefaults__ChatBaseUrl=http://localhost:11434   (or an online service, for example https://generativelanguage.googleapis.com/v1beta/openai)
# AiDefaults__ChatModel=gemini-3.8-flash
